# منفذ السيرفر
PORT=8080

# مفتاح OpenAI API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# استراتيجية النماذج للذكاء الاصطناعي
OPENAI_MODEL=gpt-5-mini
OPENAI_PROGRAM_MODEL=gpt-5-mini
OPENAI_COACH_MODEL=gpt-5-mini

# سر توقيع الجلسات — JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# مسار قاعدة البيانات
DATABASE_FILE=./data/coachmint.db

# النطاقات المسموح لها بالاتصال (اتركها فارغة للسماح للكل أثناء التطوير)
CORS_ORIGINS=

# ---------------------------------------------------------------------
# اشتراكات Apple (In-App Purchase)
# ---------------------------------------------------------------------
# مطلوبة لتفعيل الاشتراكات. بدونها يعمل التطبيق على الخطة المجانية فقط.
# التفاصيل الكاملة في docs/SUBSCRIPTIONS.md

# معرّف الحزمة كما هو في App Store Connect.
APPLE_BUNDLE_ID=com.coachmint.coachmint

# مفتاح In-App Purchase من App Store Connect → Users and Access → Integrations.
APPLE_KEY_ID=XXXXXXXXXX
APPLE_ISSUER_ID=00000000-0000-0000-0000-000000000000

# مسار ملف المفتاح الخاص (.p8). لا يُرفع للمستودع أبداً.
APPLE_PRIVATE_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
# بديل للاستضافات التي لا تسمح بالملفات — الصق المحتوى مع \n بدل الأسطر.
# APPLE_PRIVATE_KEY=

# مسار شهادة جذر Apple. نزّلها بـ: npm run fetch:apple-root
APPLE_ROOT_CA_PATH=./certs/AppleRootCA-G3.cer

# البيئة: auto (يجرّب الإنتاج ثم الرمل) أو sandbox أو production.
APPLE_ENVIRONMENT=auto

# معرّفات المنتجات — عدّلها فقط إن غيّرت التسمية في App Store Connect.
APPLE_PRODUCT_SINGLE_MONTHLY=com.coachmint.sub.single.monthly
APPLE_PRODUCT_TRIO_MONTHLY=com.coachmint.sub.trio.monthly
APPLE_PRODUCT_UNLIMITED_YEARLY=com.coachmint.sub.unlimited.yearly

# اضبطها على production في بيئة الإنتاج: تجعل التحقق من التوقيع إلزامياً.
NODE_ENV=development

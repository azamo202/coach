# منفذ السيرفر
PORT=8080

# مفتاح OpenAI API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# استراتيجية النماذج للذكاء الاصطناعي
OPENAI_MODEL=gpt-5-mini
OPENAI_PROGRAM_MODEL=gpt-5-mini
OPENAI_COACH_MODEL=gpt-5-mini

# سر توقيع الجلسات — JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# مسار قاعدة البيانات
DATABASE_FILE=./data/coachmint.db

# النطاقات المسموح لها بالاتصال (اتركها فارغة للسماح للكل أثناء التطوير)
CORS_ORIGINS=

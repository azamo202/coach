# منفذ السيرفر
PORT=8080

# مفتاح Anthropic — لا يُشحن أبداً مع التطبيق، يبقى هنا فقط
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# سر توقيع الجلسات — غيّره لقيمة عشوائية طويلة قبل النشر
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# مسار قاعدة البيانات
DATABASE_FILE=./data/coachmint.db

# النطاقات المسموح لها بالاتصال (اتركها فارغة للسماح للكل أثناء التطوير)
CORS_ORIGINS=
